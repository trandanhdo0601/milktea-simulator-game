# Copy file này thành .env và điền giá trị thực
# KHÔNG commit .env lên GitHub

# Mật khẩu root dành cho quản trị database
MYSQL_ROOT_PASSWORD=YourStrongRootPassword123!

# Mật khẩu của tài khoản ứng dụng
MYSQL_PASSWORD=YourStrongAppPassword123!

# JWT Secret - tạo bằng: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_secret_key_here

# JWT expiry (milliseconds) = 24 giờ
JWT_EXPIRATION=86400000
